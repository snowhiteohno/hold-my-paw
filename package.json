    "test:postcard": "node scripts/postcard.cjs",
    "test:picnic": "node scripts/picnic.cjs",
    "test:audio": "node scripts/audio.cjs"
  },
  "dependencies": {
    "@fontsource/dynapuff": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
